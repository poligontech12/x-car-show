{
  "name": "x-car-show",
  "version": "0.1.0",
  "private": true,
  "description": "X Car Show — Cajvana, Suceava. Annual meet + year-round community.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "demo:photos": "tsx --env-file=.env.local scripts/fetch-demo-photos.ts",
    "db:seed": "tsx --env-file=.env.local scripts/seed.ts",
    "db:deploy": "node --env-file-if-exists=.env.local scripts/migrate.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "better-auth": "^1.6.25",
    "drizzle-orm": "^0.45.2",
    "next": "16.3.0",
    "postgres": "^3.4.9",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "server-only": "^0.0.1",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.1.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "agentation": "^3.0.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.0",
    "tsx": "^4.23.5",
    "typescript": "6.0.3"
  },
  "overrides": {
    "sharp@<0.35.0": "0.35.3"
  }
}
