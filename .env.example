# ── Local development (.env.local) ──────────────────────────────────────
# Local Postgres, started with: brew services start postgresql@17
DATABASE_URL=postgres://localhost:5432/xcarshow

# Signs session cookies. Generate with: openssl rand -base64 32
# Changing it on a live deploy signs everybody out.
BETTER_AUTH_SECRET=

# The public origin. Inlined at build time and encoded into every printed
# QR code — settle it before any card goes to print. Keep it as localhost
# here, so scanning a development card does not send you to production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000


# ── On the server, the file is called .env and holds only these three ───
# POSTGRES_PASSWORD=<anything long; only the app and psql ever see it>
# BETTER_AUTH_SECRET=<openssl rand -base64 32>
# NEXT_PUBLIC_SITE_URL=https://xcarshow.poligontech.ro
#
# DATABASE_URL is not set there — compose builds it from POSTGRES_PASSWORD.
# APP_PORT defaults to 3000 and APP_BIND to 127.0.0.1; set them only if
# that port is taken or your proxy runs inside Docker.
