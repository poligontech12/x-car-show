# ── Local development (.env.local) ──────────────────────────────────────
# Local Postgres, started with: brew services start postgresql@17
DATABASE_URL=postgres://localhost:5432/xcarshow

# Signs session cookies. Generate with: openssl rand -base64 32
# Changing it on a live deploy signs everybody out.
BETTER_AUTH_SECRET=

# The public origin. Inlined at build time and encoded into every printed
# QR code — settle it before any card goes to print. Keep it as localhost
# here, so scanning a development card does not send you to production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000


# ── On the server ───────────────────────────────────────────────────────
# docker-compose.yml runs Postgres only, and reads one value from .env:
#   POSTGRES_PASSWORD=<anything long>
#
# The app is built and run by x-car-show-deploy.timer, not by compose. It
# needs three variables — see the table in DEPLOY.md:
#   NEXT_PUBLIC_SITE_URL  at build time AND on the container
#   DATABASE_URL          postgres://xcs:<pw>@172.17.0.1:5432/xcarshow
#   BETTER_AUTH_SECRET    openssl rand -base64 32
#
# Optional. Any other address the app is reached at — the LAN URL, for
# instance. Comma-separated, no trailing slash. Without it, opening the
# app on one of those addresses fails with "Invalid origin".
#   TRUSTED_ORIGINS=http://192.168.1.25:3000
