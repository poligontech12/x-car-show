# Local Postgres (brew services start postgresql@17). On the server this
# points at the compose service: postgres://xcs:<password>@db:5432/xcarshow
DATABASE_URL=postgres://localhost:5432/xcarshow

# Signs session cookies. Generate with: openssl rand -base64 32
# Changing it on a live deploy signs everybody out.
BETTER_AUTH_SECRET=

# The public origin. Inlined at build time and encoded into every printed
# QR code — settle it before any card goes to print. Locally, leave it as
# localhost so scanning a dev card does not send you to production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Server only (docker compose reads .env, not .env.local) ─────────────
# POSTGRES_PASSWORD=
# SITE_HOST=xcarshow.poligontech.ro
# NEXT_PUBLIC_SITE_URL=https://xcarshow.poligontech.ro
